<mxfile host="app.diagrams.net"><diagram name="Arquitectura nivel 3" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Nivel 3 · Componentes del metacompilador" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#2b2b2b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="28" as="geometry"/></mxCell><mxCell id="c3" value="Paquete metacompilador (Python)" style="rounded=1;arcSize=3;dashed=1;dashPattern=8 5;strokeWidth=1.3;fillColor=#FBFBFA;strokeColor=#9a9a95;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1720" height="840" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Orquestador&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#6b6b6b'&gt;[compilador.py]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Encadena las 4 etapas y detiene el proceso ante errores&lt;/font&gt;" style="rounded=1;arcSize=9;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#2b2b2b;spacing=10;fillColor=#FCEBD6;strokeColor=#D9923B;" vertex="1" parent="1"><mxGeometry x="710" y="110" width="340" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Analizador léxico&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#6b6b6b'&gt;[lexer.py]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Expresiones regulares → tokens; errores L01-L04&lt;/font&gt;" style="rounded=1;arcSize=9;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#2b2b2b;spacing=10;fillColor=#E3EEF9;strokeColor=#5B8DB8;" vertex="1" parent="1"><mxGeometr